{
  "extends": ["@wolfgames/game-dev/config/biome"],
  "files": {
    "includes": [
      "**",
      "!dist",
      "!index.html",
      "!test-results",
      "!playwright-report",
      "!kits/*/files"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["~/game/*", "~/game/**"],
                    "message": "core/ must not import from game/ — dependency flows core → game"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
