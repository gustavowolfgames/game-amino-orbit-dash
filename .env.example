# Must equal gameSlug in wolf-game-kit.json — Dynamic Data (packs, brand) is keyed by it.
VITE_GAME_KIT_PROJECT_ID=game-amino-orbit-dash
# Release the Content Pack bundle URL is suffixed with ([@<release>]). Deployed builds read it
# from _release.json; locally that file does not exist, and without this the pack 404s and the
# game silently plays the bundled pack. Restart the dev server after changing it.
VITE_RELEASE_NAME=main
# Nucleo environment the game's assets and Dynamic Data come from (QA | Staging | Production | Development).
# `bun run build` refuses to run without it, and VITE_APP_ENV must match it.
VITE_GAME_KIT_ENV=Staging
VITE_APP_ENV=Staging
VITE_POSTHOG_API_KEY=

# Set to any truthy value to completely disable the version banner overlay
# VITE_DISABLE_VERSION_BANNER=

# -----------------------------------------------------------------------------
# Asset generation (wolf-game-kit MCP)
# The key does NOT go here. Put it in the `env` block of .mcp.json
# (machine-local, gitignored) or export it from your shell — both win over
# this file, which does not reliably reach the MCP server at all.
# Keys are per environment: STAGING_ASSET_GEN_API_KEY for Staging.
# See the wolf-game-kit MCP setup guide for local configuration.
# Never commit a real key (pre-commit blocks wg_ag_* keys).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Carina, the creative knowledge base (game feel patterns), for `bun run carina <words>`.
# Path to a wolfgames/carina checkout; relative paths resolve from this repo. Empty means
# ../carina next to this repo. Local only: put it in .env.local. .agents/recipes/feel.md.
# -----------------------------------------------------------------------------
CARINA_DIR=

# Base URL for embed bundles (config.json, game.json) fetched in embedded mode
VITE_EMBED_STORAGE_URL=

# Optional player-data host override (default: player-data.{env}.wolf.games).
# VITE_PLAYER_DATA_HOST=

# -----------------------------------------------------------------------------
# @wolfgames/components dev overrides (LOCAL ONLY — put these in .env.local)
#
# Both flags are read by vite.config.ts and ignored during production builds.
# `.env.local` is gitignored so they never accidentally ship.
#
#   VITE_COMPONENTS_LOCAL=1   Resolve from sibling repo ../game-components/
#                             instead of node_modules. Use when iterating on
#                             game-components in this monorepo.
#
#   VITE_COMPONENTS_SOURCE=1  Resolve from raw src/ instead of compiled dist/.
#                             Use for HMR straight off .ts source — no rebuild
#                             needed after each change.
#
# Fastest inner loop:
#   echo 'VITE_COMPONENTS_LOCAL=1' >> .env.local
#   echo 'VITE_COMPONENTS_SOURCE=1' >> .env.local
#   bun run dev
# -----------------------------------------------------------------------------
# VITE_COMPONENTS_LOCAL=
# VITE_COMPONENTS_SOURCE=
