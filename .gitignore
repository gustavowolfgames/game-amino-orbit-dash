# Build outputs
dist
.output
.vinxi
.vercel
.netlify
.wrangler
app.config.timestamp_*.js

# Environment
.env
.env*.local

# Dependencies
node_modules

# TypeScript
*.tsbuildinfo

# Testing
coverage
test-results
playwright-report
.playwright-mcp

# Logs
*.log

# IDEs and editors
.idea
.vscode/*
!.vscode/extensions.json

# Editor backups
*.swp
*.swo
*~
*.bak

# System files
.DS_Store
Thumbs.db
Desktop.ini

# MCP (machine-local — provisioned by workspace setup / Nucleo Studio)
.mcp.json

# CDN-first asset working dir — only the lockfile and registry.ts are
# committed (see assets/README.md).
assets/src/*
!assets/src/.gitkeep

# Cortex output (only when agentSurface.cortex is on; scripts/agent-surface.mjs runs cortex setup).
# .agents/skills/ is ignored per entry, not as a folder, so the recipes' own skills below stay
# tracked: a copy made with `git add -A` (nucleo game create) keeps them.
.agents/rules/
.agents/skills/*
!.agents/skills/game-controller/
!.agents/skills/pixi-gameplay/
.agents/commands/
.claude/rules/
.claude/skills/
.claude/commands/
.claude/hooks/
.claude/rules.md
docs/cortex-inventory.md

# Cursor support is deprecated — cortex 0.5.0 reroutes generated scaffolding to .agents/ and .claude/.
.cursor/

# Cache
.cache
.eslintcache

# Local Pyxis index (16MB, machine-local — never commit)
.pyxis/

# `wolf-dev assets hydrate` output: build input for a frozen bundle, pulled
# from the CDN on demand.
public/assets/cdn/

# decompose:content output — regenerate from src/game/content/packs, never commit
local/content-packs/
