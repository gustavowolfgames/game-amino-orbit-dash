{
  "name": "template-amino-ecs-pure",
  "type": "module",
  "scripts": {
    "predev": "bun run cortex:setup",
    "dev": "vite",
    "build": "vite build",
    "build:frozen": "VITE_IS_FROZEN=true vite build --base=./",
    "build:qa": "vite build --mode qa",
    "preview": "vite preview",
    "format": "biome check --write .",
    "format:src": "biome check --write ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "amino:sync": "bun run scripts/amino-sync.ts",
    "amino:release": "bun run scripts/amino-release.ts",
    "amino:verify": "bun run scripts/amino-verify.ts",
    "amino:rollback": "bun run scripts/amino-rollback.ts",
    "amino:drift": "bun run scripts/amino-drift.ts",
    "assets:publish": "bun run check:assets && wolf-dev assets publish",
    "assets:release": "wolf-dev assets release",
    "assets:verify": "wolf-dev assets verify",
    "check:assets": "bun run scripts/check-asset-naming.ts",
    "check:manifest": "bun run scripts/check-manifest.ts",
    "typecheck": "tsc --noEmit",
    "lint:unused": "knip",
    "cortex:setup": "node node_modules/@wolfgames/cortex/scripts/setup.mjs",
    "cortex:refresh": "bun update @wolfgames/cortex",
    "postinstall": "node node_modules/@wolfgames/cortex/scripts/setup.mjs",
    "prepare": "husky",
    "use:local": "../../scripts/use-local.sh",
    "use:remote": "../../scripts/use-remote.sh",
    "status": "../../scripts/status.sh"
  },
  "cortex": {
    "profile": "default"
  },
  "dependencies": {
    "@adobe/data": "^0.9.73",
    "@sentry/solid": "^10.63.0",
    "@wolfgames/client": "^0.1.13",
    "@wolfgames/components": "^2.1.0",
    "@wolfgames/cortex": "^0.5.0",
    "@wolfgames/shared": "^0.3.0",
    "arktype": "^2.2.2",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.19.0",
    "posthog-js": "^1.396.5",
    "solid-js": "^1.9.14",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/howler": "^2.2.13",
    "@wolfgames/dev": "^0.2.13",
    "husky": "^9.1.7",
    "knip": "^6.24.0",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.2",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^2.1.9"
  },
  "amino": {
    "version": "1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
