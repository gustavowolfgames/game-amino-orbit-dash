{
  "name": "template-amino-ecs-pure",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:frozen": "VITE_IS_FROZEN=true vite build --base=./",
    "build:qa": "vite build --mode qa",
    "preview": "vite preview",
    "format": "biome check --write .",
    "format:src": "biome check --write ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "amino:sync": "bun run scripts/amino-sync.ts",
    "amino:release": "bun run scripts/amino-release.ts",
    "amino:verify": "bun run scripts/amino-verify.ts",
    "amino:rollback": "bun run scripts/amino-rollback.ts",
    "amino:drift": "bun run scripts/amino-drift.ts",
    "assets:publish": "bun run check:assets && wolf-dev assets publish",
    "assets:release": "wolf-dev assets release",
    "assets:verify": "wolf-dev assets verify --budget",
    "check:assets": "bun run scripts/check-asset-naming.ts",
    "check:manifest": "bun run scripts/check-manifest.ts",
    "decompose:content": "bun run scripts/decompose-content.ts",
    "carina": "node scripts/carina.mjs",
    "typecheck": "tsc --noEmit",
    "lint:unused": "knip",
    "prepare": "husky",
    "typecheck:baseline": "node scripts/typecheck-baseline.mjs",
    "check:agent": "node scripts/check-agent-surface.mjs && node scripts/check-snippets.mjs && bun run check:assets && bun run check:manifest",
    "check": "nucleo game check local",
    "check:fix": "nucleo game check local --fix",
    "prebuild": "nucleo game check local --tier 0 --no-commit-hooks --warn-only || echo \"[prebuild] nucleo not available; skipped game checks\"",
    "add-kit": "node scripts/add-kit.mjs"
  },
  "dependencies": {
    "@adobe/data": "^0.9.103",
    "@sentry/browser": "^10.73.0",
    "@wolfgames/client": "^0.1.62",
    "@wolfgames/components": "^2.4.2",
    "arktype": "^2.2.3",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.20.1",
    "posthog-js": "^1.422.5",
    "solid-js": "^1.9.15",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tweakpane/core": "^2.0.5",
    "@types/howler": "^2.2.13",
    "@wolfgames/game-dev": "^0.1.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.12"
  },
  "amino": {
    "version": "1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
